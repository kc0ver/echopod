{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (Debug, sanitizers)",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ECHO_SANITIZE": "ON"
      }
    },
    {
      "name": "device",
      "displayName": "Device firmware (Cortex-M3, Release -O2)",
      "binaryDir": "${sourceDir}/build/device",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-O2",
        "ECHO_BUILD_SIM": "OFF",
        "ECHO_BUILD_TESTS": "OFF",
        "ECHO_BUILD_DEVICE": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release firmware (device build without developer Diagnostics)",
      "inherits": "device",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "ECHO_RELEASE": "ON"
      }
    },
    {
      "name": "slim",
      "displayName": "Slim firmware (MP3/FLAC, no MP4, Ogg, Bluetooth or equalizer)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/slim",
      "cacheVariables": {
        "ECHO_FEATURE_MP4": "OFF",
        "ECHO_FEATURE_OGG": "OFF",
        "ECHO_FEATURE_BLUETOOTH": "OFF",
        "ECHO_FEATURE_EQUALIZER": "OFF"
      }
    },
    {
      "name": "minimal",
      "displayName": "Minimal firmware (Bluetooth only, no WAV, QOA, extra formats or release diagnostics)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/minimal",
      "cacheVariables": {
        "ECHO_FEATURE_MP4": "OFF",
        "ECHO_FEATURE_OGG": "OFF",
        "ECHO_FEATURE_BLUETOOTH": "ON",
        "ECHO_FEATURE_EQUALIZER": "OFF",
        "ECHO_FEATURE_WAV": "OFF",
        "ECHO_FEATURE_QOA": "OFF",
        "ECHO_FEATURE_EXTRA_INDEX": "OFF",
        "ECHO_RELEASE_VERSION_ONLY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "device",
      "configurePreset": "device"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "slim",
      "configurePreset": "slim"
    },
    {
      "name": "minimal",
      "configurePreset": "minimal"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
